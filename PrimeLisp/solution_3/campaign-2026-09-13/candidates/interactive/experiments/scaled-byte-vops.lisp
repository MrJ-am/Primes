(in-package #:prime-candidate)
(declaim (optimize (speed 3) (safety 0) (debug 1)))
(defun or-byte-scaled! (sap index scale displacement mask)
  (declare (type sb-sys:system-area-pointer sap) (type (signed-byte 64) index)
           (type (member 1 2 4 8) scale) (type (signed-byte 32) displacement)
           (type (unsigned-byte 8) mask))
  (let ((offset (the (signed-byte 64) (+ (* index scale) displacement))))
    (setf (sb-sys:sap-ref-8 sap offset) (logior (sb-sys:sap-ref-8 sap offset) mask)))
  (values))
(defun or-byte-constant! (sap displacement mask)
  (declare (type sb-sys:system-area-pointer sap) (type (signed-byte 32) displacement)
           (type (unsigned-byte 8) mask))
  (setf (sb-sys:sap-ref-8 sap displacement)
        (logior (sb-sys:sap-ref-8 sap displacement) mask))
  (values))
(eval-when (:compile-toplevel :load-toplevel :execute)
  (sb-c:defknown or-byte-scaled! (sb-sys:system-area-pointer (signed-byte 64) (member 1 2 4 8) (signed-byte 32) (unsigned-byte 8)) (values) (sb-c:always-translatable))
  (sb-c:define-vop (or-byte-scaled!)
    (:translate or-byte-scaled!) (:policy :fast-safe)
    (:args (sap :scs (sb-vm::sap-reg)) (index :scs (sb-vm::signed-reg)))
    (:arg-types sb-vm::system-area-pointer sb-vm::signed-num (:constant (member 1 2 4 8)) (:constant (signed-byte 32)) (:constant (unsigned-byte 8)))
    (:info scale displacement mask)
    (:generator 1 (sb-assem:inst or :byte (sb-vm::ea displacement sap index scale) mask)))
  (sb-c:defknown or-byte-constant! (sb-sys:system-area-pointer (signed-byte 32) (unsigned-byte 8)) (values) (sb-c:always-translatable))
  (sb-c:define-vop (or-byte-constant!)
    (:translate or-byte-constant!) (:policy :fast-safe)
    (:args (sap :scs (sb-vm::sap-reg)))
    (:arg-types sb-vm::system-area-pointer (:constant (signed-byte 32)) (:constant (unsigned-byte 8)))
    (:info displacement mask)
    (:generator 1 (sb-assem:inst or :byte (sb-vm::ea displacement sap) mask))))
